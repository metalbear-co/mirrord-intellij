<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <rider.patchCommandLine implementation="com.metalbear.mirrord.products.rider.RiderPatchCommandLineExtension" />
        <rider.dotNetProjectConfigurationExtension implementation="com.metalbear.mirrord.products.rider.RiderDebugDotNetProjectConfigurationExtension" />
    </extensions>
    
    <projectListeners>
        <listener class="com.metalbear.mirrord.products.rider.RiderDebugAttachListener"
                  topic="com.intellij.xdebugger.XDebuggerManagerListener"/>
    </projectListeners>
</idea-plugin>
