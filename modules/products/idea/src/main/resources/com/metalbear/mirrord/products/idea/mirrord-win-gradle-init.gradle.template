// Gradle init script injected by the mirrord IntelliJ plugin on Windows-native
// runs. There is no `LD_PRELOAD` on Windows, so for each matched JavaExec task we
// relaunch its JVM under `mirrord pitm`, which starts the process suspended and
// injects the layer DLL before resuming. Mirrord env reaches the child via the
// MIRRORD_CHILD_ENV payload that pitm decodes.
//
// This is used for both Run and Debug. In Debug the forked JVM keeps IntelliJ's
// dispatched `-agentlib:jdwp` argument (we forward `task.allJvmArgs` verbatim),
// so the debugger still attaches to the now-injected JVM.
//
// Task selection: we only touch JavaExec tasks that the user/IDE actually asked
// to run — i.e. whose name or path appears in `gradle.startParameter.taskNames`.
// This covers:
//   - IntelliJ's synthesized run-a-main-method task (e.g. `:org.example.Main.main()`),
//     created by ApplicationTaskInitScript from the Gradle tooling extension
//   - the `run` task added by the `application` plugin
//   - qualified subproject tasks like `:sub:run`
//   - any user-defined JavaExec the user invokes
// Tasks reached only as transitive build dependencies (e.g. a code-generator
// JavaExec pulled in by `build`) are intentionally NOT touched.
//
// Placeholders (substituted at runtime by MirrordWinGradleInjector.kt):
//   __MIRRORD_CLI_PATH__      absolute path to mirrord.exe
//   __MIRRORD_CHILD_ENV_VAR__ name of the MIRRORD_CHILD_ENV env var

import javax.inject.Inject
import org.gradle.process.ExecOperations

abstract class MirrordExecInjector {
    @Inject abstract ExecOperations getExecOps()
}

def mirrordStandardTaskActionClass = 'org.gradle.api.internal.project.taskfactory.StandardTaskAction'

def mirrordEscapeArg = { s ->
    '"' + String.valueOf(s).replace('\\', '\\\\').replace('"', '\\"') + '"'
}

// Task-selection predicate: does a candidate JavaExec task correspond to a task
// the user/IDE actually requested? Extracted verbatim by MirrordWinGradleInjectorTest
// via the markers below — keep this block self-contained (it may reference only
// `gradle` and each candidate `task`).
//
// Drop a single leading ':' so an IDE-supplied qualified name (`sub:bootRun`)
// lines up with Gradle's absolute task path (`:sub:bootRun`). IntelliJ passes
// task names WITHOUT the leading colon, while `task.path` always carries one —
// comparing them raw silently misses every subproject task (layer never loads).
// mirrord-test:task-match:start
def mirrordStripLeadingColon = { String s -> s.startsWith(':') ? s.substring(1) : s }
def mirrordRequestedTasks = (gradle.startParameter.taskNames ?: [])
    .collect { mirrordStripLeadingColon(it as String) } as Set
def mirrordMatchesRequested = { task ->
    if (mirrordRequestedTasks.isEmpty()) return false
    // Colon-normalized absolute path: `:sub:bootRun` -> `sub:bootRun`, root `:bootRun` -> `bootRun`.
    // Precisely matches a qualified request without over-matching a same-named task in another project.
    if (mirrordRequestedTasks.contains(mirrordStripLeadingColon(task.path))) return true
    // Bare task name matches an unqualified request (`bootRun`), which targets that
    // task in every project — preserving the requested-name semantics.
    if (mirrordRequestedTasks.contains(task.name)) return true
    return false
}
// mirrord-test:task-match:end

// Extract the JDWP debugger port from a task's JVM args. In Debug, IntelliJ's
// `ijJvmDebugger` init script appends `-agentlib:jdwp=transport=dt_socket,...,address=host:PORT`
// to the forked JVM. The layer must be told to ignore that port (via
// MIRRORD_IGNORE_DEBUGGER_PORTS) or it routes the debugger's loopback connection through the
// remote target and the JDWP handshake is reset ("JDWP TRANSPORT_INIT(510)"), aborting the JVM.
// Belt-and-suspenders until the layer's own `javaagent` autodetection handles the Windows/pitm
// case natively (COR-1706) and becomes our minimum binary version — pitm passes every JVM arg
// through an @argfile, which older layers don't scan. Returns null when not debugging.
// mirrord-test:debugger-port:start
def mirrordDetectDebuggerPort = { jvmArgs ->
    for (a in (jvmArgs ?: [])) {
        def s = a as String
        if (s.startsWith('-agentlib:jdwp=') && s.contains('transport=dt_socket')) {
            def m = (s =~ /address=([^,]+)/)
            if (m.find()) {
                def addr = m.group(1).trim()
                def ci = addr.lastIndexOf(':')
                return (ci >= 0 ? addr.substring(ci + 1) : addr).trim()
            }
        }
    }
    return null
}
// mirrord-test:debugger-port:end

// Merge an extra ignored debugger port into the base64-JSON MIRRORD_CHILD_ENV payload that pitm
// forwards to the child. The layer reads MIRRORD_IGNORE_DEBUGGER_PORTS from the child env, and pitm
// rebuilds that env from this payload — so a plain `spec.environment(...)` would be overwritten by
// the payload's own MIRRORD_IGNORE_DEBUGGER_PORTS (the plugin already sets a `35000-65535` range).
// Prepending here keeps both. Returns the payload unchanged when it is empty. `payload` is passed in
// so this stays unit-testable.
// mirrord-test:merge-ignore-port:start
def mirrordMergeIgnoredDebuggerPort = { payload, port ->
    if (!payload) return payload
    def decoded = new groovy.json.JsonSlurper()
        .parseText(new String(java.util.Base64.decoder.decode(payload), 'UTF-8'))
    def set = decoded.set ?: [:]
    def existing = set['MIRRORD_IGNORE_DEBUGGER_PORTS']
    set['MIRRORD_IGNORE_DEBUGGER_PORTS'] = existing ? (port + ',' + existing) : port
    decoded.set = set
    return java.util.Base64.encoder.encodeToString(
        groovy.json.JsonOutput.toJson(decoded).getBytes('UTF-8'))
}
// mirrord-test:merge-ignore-port:end

allprojects {
    def execOps = project.objects.newInstance(MirrordExecInjector).execOps
    tasks.withType(JavaExec).configureEach { task ->
        if (!mirrordMatchesRequested(task)) return

        // Relaunch the real java under `mirrord pitm`, suspended, so the layer DLL
        // is injected before user code runs.
        task.doLast {
            // `task.executable` is null whenever the task runs on the Gradle toolchain
            // launcher instead of an explicitly-set executable — the normal case for
            // Spring Boot's bootRun and the `application` plugin's `run`. Fall back to the
            // launcher's java (then the build JVM) so we never pass a null arg to pitm.
            def realJava = task.executable
            if (!realJava) {
                def mirrordLauncher = task.javaLauncher.getOrNull()
                realJava = mirrordLauncher != null
                    ? mirrordLauncher.executablePath.asFile.absolutePath
                    : new File(new File(System.getProperty('java.home'), 'bin'), 'java').absolutePath
            }
            // Non-null in Debug only; merged into the child env below so the layer ignores the
            // debugger's loopback port instead of tunnelling it to the target.
            def mirrordDebuggerPort = mirrordDetectDebuggerPort(task.allJvmArgs)
            def mirrordChildEnv = System.getenv('__MIRRORD_CHILD_ENV_VAR__') ?: ''
            if (mirrordDebuggerPort) {
                mirrordChildEnv = mirrordMergeIgnoredDebuggerPort(mirrordChildEnv, mirrordDebuggerPort)
            }
            def argfile = File.createTempFile('mirrord-win-gradle-', '.args')
            argfile.deleteOnExit()
            def lines = []
            task.allJvmArgs.each { lines << mirrordEscapeArg(it) }
            lines << '-cp'
            lines << mirrordEscapeArg(task.classpath.asPath)
            if (task.mainClass.isPresent()) lines << mirrordEscapeArg(task.mainClass.get())
            (task.args ?: []).each { lines << mirrordEscapeArg(it) }
            task.argumentProviders.each { p ->
                p.asArguments().each { lines << mirrordEscapeArg(it) }
            }
            argfile.text = lines.join(System.lineSeparator())
            execOps.exec { spec ->
                spec.executable '__MIRRORD_CLI_PATH__'
                spec.args 'pitm', '--', realJava, '@' + argfile.absolutePath
                spec.environment(task.environment)
                spec.environment('__MIRRORD_CHILD_ENV_VAR__', mirrordChildEnv)
                spec.workingDir = task.workingDir
                spec.standardInput = System.in
            }
        }
        task.actions.removeAll { it.class.name == mirrordStandardTaskActionClass }
    }
}
